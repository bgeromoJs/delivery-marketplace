# Copie para .env e ajuste se necessário. O .env não é versionado.
#   Copy-Item .env.example .env

# --- Segurança -------------------------------------------------------------
# Mesmo segredo no identity-service e no api-gateway. Trocar em qualquer
# ambiente que não seja a máquina do desenvolvedor.
JWT_SECRET=deliveryhub-local-only-secret-key-change-before-deploy-2026

# --- Dados de demonstração -------------------------------------------------
# true  = popula lojas, pratos, usuários e pedidos de exemplo na subida
# false = banco vazio (só o schema do Liquibase)
APP_SEED_DEMO_DATA=true

# --- Frontend --------------------------------------------------------------
# Embutido no bundle do browser em tempo de BUILD. Alterar exige rebuild da
# imagem: docker compose --profile apps build web
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Mensageria ------------------------------------------------------------
# false = order-service não publica no Redpanda (SSE continua funcionando)
KAFKA_ENABLED=true
